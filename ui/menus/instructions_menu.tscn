[node name="Label2" type="Label" parent="VBoxContainer/Panel/MarginContainer/VBoxContainer" unique_id=299273956]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
text = "All the delicious fruits of the Smoothie Kingdom were stolen by Pulp, the nefarious fruit-themed wizard! \"NYAH HA HAAA! I'M MAKING A COBBLER!\" he cackled. He was out of milk so it wasn't even going to be a very good cobbler.

Using dark magic, he corrupted the friendly animals and also forced everyone to keep moving to the right or something.

Anyway the wizard died from an unrelated incident but we still kinda want the fruit back. It's up to Otto to get to the end of the levels and get fruits!"
autowrap_mode = 2

