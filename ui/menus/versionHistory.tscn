layout_mode = 2
text = "- Major re-work for levels 3 to 6. Head on to the signposted gimmick, or take the mystery level instead.
- Added option to attempt Twitch login automatically at launch
- Added ability to read chat messages from an externally managed text file (for advanced users who want to cobble together YouTube/Tiktok integration)
- Camera now scrolls up slightly when standing above the level
- Kaizo blocks no longer overlap or spawn directly above other kaizo blocks
- Improved spikes icon
- Sky level now has a nice cloudy background
- Fixed death sound not respecting sfx volume level
- Added BIG BEEF somewhere"
autowrap_mode = 2

