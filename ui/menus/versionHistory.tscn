[node name="Label4" type="Label" parent="VBoxContainer/Panel/MarginContainer/ScrollContainer/VBoxContainer" unique_id=613413035]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
text = "- Spikes can now spawn properly
- Added a new game option to conceal upcoming spawns
- When CPU players are active, human players' spawns will be prioritized
- Added spawn points for coins and enemies to the end-of-level chunk
- Added simplified chatter instuctions to the sidebar
- Fixed issue where life counter spinbox in game setup would be desynced from actual value
- Fixed issue with pause menu's Quit Game button"
autowrap_mode = 2

